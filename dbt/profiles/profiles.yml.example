# Copy this file to profiles/profiles.yml and fill in your values.
# profiles.yml is gitignored — never commit credentials.
#
# dataset must be the environment name only (dev, prod).
# The generate_schema_name macro combines it with the model schema:
#   raw   + dev  →  raw_dev
#   staging + dev →  staging_dev
#   mart  + dev  →  mart_dev

default:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: oauth
      project: datalab-project-472519
      dataset: dev
      location: US
      threads: 4
      timeout_seconds: 300

    prod:
      type: bigquery
      method: oauth
      project: datalab-project-472519
      dataset: prod
      location: US
      threads: 8
      timeout_seconds: 300

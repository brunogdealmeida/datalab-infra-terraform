# Copy this file to profiles/profiles.yml and fill in your values.
# profiles.yml is gitignored — never commit credentials.
#
# This file is also the template for the Secret Manager secret (dbt-profiles-yml).
# Upload it after filling in real values:
#   gcloud secrets versions add dbt-profiles-yml \
#     --data-file=profiles/profiles.yml \
#     --project=datalab-project-472519

default:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: oauth            # uses ADC locally; on Cloud Run uses the job's SA
      project: datalab-project-472519
      dataset: staging_dev
      location: US
      threads: 4
      timeout_seconds: 300

    prod:
      type: bigquery
      method: oauth
      project: datalab-project-472519
      dataset: staging
      location: US
      threads: 8
      timeout_seconds: 300
